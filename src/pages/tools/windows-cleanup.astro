
---
const pageTitle = "Windows Cleanup Toolkit";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta
    name="description"
    content="Free Windows Cleanup Toolkit. Generate PowerShell scripts with preview-first cleanup, disk space analysis, and detailed reports."
  />
  <title>{pageTitle} | Shaune Drake Tech</title>

  <style>
    :root {
      font-family: Inter, system-ui, Arial, sans-serif;
      background: #0b1220;
      color: #e2e8f0;
      color-scheme: dark;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
    }

    a {
      color: #38bdf8;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 950px;
      margin: auto;
      padding: 0 24px;
    }

    header {
      padding: 22px 0;
      border-bottom: 1px solid #26364d;
    }

    .logo {
      font-size: 21px;
      font-weight: 800;
      color: white;
    }

    .logo span {
      color: #38bdf8;
    }

    main {
      padding-top: 45px;
      padding-bottom: 80px;
    }

    h1 {
      font-size: clamp(32px, 5vw, 50px);
      color: white;
      margin: 25px 0 16px;
      letter-spacing: -1px;
    }

    h2 {
      color: white;
      font-size: 23px;
    }

    .subtitle {
      color: #94a3b8;
      line-height: 1.7;
      font-size: 17px;
    }

    .version {
      display: inline-block;
      padding: 7px 12px;
      background: #12344b;
      color: #7dd3fc;
      border: 1px solid #075985;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      margin-top: 16px;
    }

    .panel {
      margin-top: 32px;
      background: #172338;
      border: 1px solid #26364d;
      border-radius: 16px;
      padding: 28px;
    }

    .option {
      display: flex;
      gap: 15px;
      align-items: flex-start;
      padding: 21px 0;
      border-bottom: 1px solid #26364d;
    }

    .option:last-of-type {
      border-bottom: 0;
    }

    input[type="checkbox"] {
      width: 21px;
      height: 21px;
      accent-color: #0284c7;
      flex-shrink: 0;
      margin-top: 3px;
      cursor: pointer;
    }

    label {
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }

    .description {
      color: #94a3b8;
      font-size: 13px;
      line-height: 1.6;
      margin-top: 6px;
    }

    .button {
      display: inline-block;
      padding: 14px 22px;
      background: #0284c7;
      color: white;
      border: 0;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
    }

    .button:hover {
      background: #0369a1;
      text-decoration: none;
    }

    .button.secondary {
      background: #334155;
    }

    .button.secondary:hover {
      background: #475569;
    }

    .button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 22px;
    }

    .notice {
      color: #94a3b8;
      font-size: 13px;
      line-height: 1.7;
      margin-top: 22px;
    }

    .warning {
      padding: 16px;
      background: #302516;
      border: 1px solid #92400e;
      border-radius: 10px;
      color: #fcd34d;
      font-size: 13px;
      line-height: 1.7;
      margin-top: 20px;
    }

    .info {
      padding: 16px;
      background: #102b40;
      border: 1px solid #075985;
      border-radius: 10px;
      color: #bae6fd;
      font-size: 13px;
      line-height: 1.7;
      margin-top: 20px;
    }

    .success {
      color: #86efac;
      font-size: 14px;
      margin-top: 18px;
    }

    .preview {
      margin-top: 20px;
      padding: 18px;
      background: #080f1c;
      border: 1px solid #334155;
      border-radius: 10px;
      color: #a5f3fc;
      font-family: Consolas, monospace;
      font-size: 13px;
      line-height: 1.6;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      max-height: 500px;
      overflow-y: auto;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 24px;
    }

    .feature {
      background: #101d30;
      padding: 16px;
      border-radius: 10px;
      border: 1px solid #26364d;
      font-size: 14px;
      line-height: 1.5;
    }

    .feature strong {
      display: block;
      color: white;
      margin-bottom: 5px;
    }

    .hidden {
      display: none;
    }

    footer {
      border-top: 1px solid #26364d;
      padding: 30px 0;
      color: #64748b;
      text-align: center;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      .panel {
        padding: 22px;
      }

      .actions {
        flex-direction: column;
      }

      .button {
        width: 100%;
      }

      .features {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="container">
      <a class="logo" href="/">
        SD<span>.</span> Shaune Drake Tech
      </a>
    </div>
  </header>

  <main class="container">
    <a href="/">← Back to Home</a>

    <div class="version">
      VERSION 1.1 • FREE WINDOWS UTILITY
    </div>

    <h1>Windows Cleanup Toolkit</h1>

    <p class="subtitle">
      Generate a customized Windows maintenance script.
      Preview eligible files, estimate recoverable disk space,
      and review cleanup results.
    </p>

    <div class="features">
      <div class="feature">
        <strong>🔍 Preview First</strong>
        Review eligible files before deletion.
      </div>

      <div class="feature">
        <strong>💾 Space Analysis</strong>
        Estimate how much disk space can be recovered.
      </div>

      <div class="feature">
        <strong>🛡️ Safety Checks</strong>
        Confirm destructive actions before cleanup.
      </div>

      <div class="feature">
        <strong>📊 Cleanup Report</strong>
        Review completed, skipped, and failed tasks.
      </div>
    </div>

    <div class="panel">
      <h2>🧹 Select Cleanup Tasks</h2>

      <div class="option">
        <input type="checkbox" id="temp" checked />
        <div>
          <label for="temp">Temporary Files</label>
          <div class="description">
            Analyze user temporary files older than 7 days.
            Display file counts and estimated space before
            offering deletion.
          </div>
        </div>
      </div>

      <div class="option">
        <input type="checkbox" id="recycle" />
        <div>
          <label for="recycle">Empty Recycle Bin</label>
          <div class="description">
            Permanently remove Recycle Bin contents only
            after explicit confirmation.
          </div>
        </div>
      </div>

      <div class="option">
        <input type="checkbox" id="dns" />
        <div>
          <label for="dns">Flush DNS Cache</label>
          <div class="description">
            Clear Windows DNS resolver cache.
            This may help troubleshoot DNS-related problems.
          </div>
        </div>
      </div>

      <div class="info">
        <strong>How preview-first cleanup works</strong>
        <p>
          The generated script scans eligible temporary files
          and calculates their total size before offering
          deletion. It will not delete files without
          confirmation.
        </p>
      </div>

      <div class="warning">
        ⚠️ Cleanup can permanently remove files.
        Back up important data, review the generated
        PowerShell script, and close applications before
        running it.
      </div>

      <div class="actions">
        <button id="generate" class="button" type="button">
          Generate PowerShell Script
        </button>
      </div>

      <p class="notice">
        This website does not scan or access your computer.
        It generates a script entirely in your browser.
        The downloaded script performs analysis only when
        you choose to run it on Windows.
      </p>
    </div>

    <div id="results" class="panel hidden" aria-live="polite">
      <h2>📄 Generated PowerShell Script</h2>

      <p class="subtitle">
        Review the complete script below.
        Download it when you are satisfied with
        the selected maintenance tasks.
      </p>

      <pre id="scriptPreview" class="preview"></pre>

      <div class="actions">
        <button id="download" class="button" type="button">
          Download PowerShell Script
        </button>

        <button id="copy" class="button secondary" type="button">
          Copy Script
        </button>
      </div>

      <p id="status" class="success" role="status"></p>
    </div>

    <div class="panel">
      <h2>How to Use</h2>

      <p class="subtitle">
        1. Select the cleanup tasks you want.
      </p>

      <p class="subtitle">
        2. Generate your customized PowerShell script.
      </p>

      <p class="subtitle">
        3. Review the commands and download the .ps1 file.
      </p>

      <p class="subtitle">
        4. Inspect the file in Notepad or another trusted
        text editor before running it.
      </p>

      <p class="subtitle">
        5. Run the script on your own Windows computer
        if permitted by its security policy.
        Review the preview and confirmation prompts.
      </p>

      <p class="notice">
        The script does not require execution-policy
        bypass commands. Do not disable Windows or
        organizational security controls to run it.
      </p>
    </div>
  </main>

  <footer>
    <div class="container">
      © {new Date().getFullYear()} Shaune Drake Tech.
      Windows Cleanup Toolkit v1.1
    </div>
  </footer>

  <script>
    const temp = document.getElementById("temp");
    const recycle = document.getElementById("recycle");
    const dns = document.getElementById("dns");

    const generateButton = document.getElementById("generate");
    const downloadButton = document.getElementById("download");
    const copyButton = document.getElementById("copy");

    const results = document.getElementById("results");
    const preview = document.getElementById("scriptPreview");
    const status = document.getElementById("status");

    let generatedScript = "";

    const header = String.raw`
# ============================================================
# Shaune Drake Tech - Windows Cleanup Toolkit v1.1
# https://shaunedrake.com
# Windows 10 / Windows 11
#
# Preview-first maintenance utility
# Review this script before running it.
# ============================================================

$ErrorActionPreference = 'Continue'

$report = [ordered]@{
    TempFilesFound   = 0
    TempFilesDeleted = 0
    TempFilesSkipped = 0
    TempBytesFound   = [long]0
    TempBytesDeleted = [long]0
    RecycleBinStatus = 'Not selected'
    DNSStatus        = 'Not selected'
}

function Format-FileSize {
    param([long]$Bytes)

    if ($Bytes -ge 1GB) {
        return ('{0:N2} GB' -f ($Bytes / 1GB))
    }

    if ($Bytes -ge 1MB) {
        return ('{0:N2} MB' -f ($Bytes / 1MB))
    }

    if ($Bytes -ge 1KB) {
        return ('{0:N2} KB' -f ($Bytes / 1KB))
    }

    return "$Bytes bytes"
}

Write-Host ''
Write-Host '========================================='
Write-Host 'Shaune Drake Tech - Windows Cleanup v1.1'
Write-Host '========================================='
Write-Host ''
`;

    const tempScript = String.raw`
# ============================================================
# TASK 1 - TEMPORARY FILE ANALYSIS
# ============================================================

Write-Host ''
Write-Host '[1] Analyzing temporary files...'

try {
    $tempPath = [System.IO.Path]::GetTempPath()

    if (-not (Test-Path -LiteralPath $tempPath)) {
        Write-Warning 'Temporary folder not found.'
    }
    else {
        $cutoff = (Get-Date).AddDays(-7)

        $files = @(
            Get-ChildItem -LiteralPath $tempPath -File -Force -Recurse -ErrorAction SilentlyContinue |
                Where-Object {
                    $_.LastWriteTime -lt $cutoff
                }
        )

        $report.TempFilesFound = $files.Count

        foreach ($file in $files) {
            $report.TempBytesFound += $file.Length
        }

        Write-Host ''
        Write-Host '--- TEMPORARY FILE PREVIEW ---'
        Write-Host ('Folder: ' + $tempPath)
        Write-Host ('Eligible files: ' + $report.TempFilesFound)
        Write-Host ('Estimated space: ' + (Format-FileSize $report.TempBytesFound))
        Write-Host 'Only files older than 7 days are eligible.'
        Write-Host ''

        if ($files.Count -gt 0) {
            Write-Host 'Sample of eligible files:'

            $files |
                Select-Object -First 10 FullName, Length |
                Format-Table -AutoSize |
                Out-Host

            Write-Host ''
            Write-Host 'This is a preview. No files have been deleted.'

            $answer = Read-Host 'Type YES to delete eligible files, or press Enter to skip'

            if ($answer -ceq 'YES') {
                foreach ($file in $files) {
                    try {
                        Remove-Item -LiteralPath $file.FullName -Force -ErrorAction Stop

                        $report.TempFilesDeleted++
                        $report.TempBytesDeleted += $file.Length
                    }
                    catch {
                        $report.TempFilesSkipped++

                        Write-Warning ('Skipped: ' + $file.FullName)
                    }
                }

                Write-Host ''
                Write-Host 'Temporary file cleanup finished.'
            }
            else {
                Write-Host 'Cleanup skipped by user.'
                $report.TempFilesSkipped = $files.Count
            }
        }
        else {
            Write-Host 'No eligible temporary files found.'
        }
    }
}
catch {
    Write-Warning ('Temporary file analysis failed: ' + $_.Exception.Message)
}
`;

    const recycleScript = String.raw`
# ============================================================
# TASK 2 - RECYCLE BIN CLEANUP
# ============================================================

Write-Host ''
Write-Host '[2] Recycle Bin maintenance...'

try {
    Write-Warning 'Recycle Bin contents will be permanently deleted.'

    $answer = Read-Host 'Type YES to empty the Recycle Bin, or press Enter to skip'

    if ($answer -ceq 'YES') {
        Clear-RecycleBin -Confirm:$false -ErrorAction Stop

        $report.RecycleBinStatus = 'Completed'
        Write-Host 'Recycle Bin cleanup completed.'
    }
    else {
        $report.RecycleBinStatus = 'Skipped by user'
        Write-Host 'Recycle Bin cleanup skipped.'
    }
}
catch {
    $report.RecycleBinStatus = 'Failed'

    Write-Warning ('Recycle Bin cleanup failed: ' + $_.Exception.Message)
}
`;

    const dnsScript = String.raw`
# ============================================================
# TASK 3 - DNS CACHE MAINTENANCE
# ============================================================

Write-Host ''
Write-Host '[3] DNS cache maintenance...'

try {
    Clear-DnsClientCache -ErrorAction Stop

    $report.DNSStatus = 'Completed'

    Write-Host 'DNS cache successfully flushed.'
}
catch {
    $report.DNSStatus = 'Failed'

    Write-Warning ('DNS cache cleanup failed: ' + $_.Exception.Message)
}
`;

    const reportScript = String.raw`
# ============================================================
# FINAL CLEANUP REPORT
# ============================================================

Write-Host ''
Write-Host '========================================='
Write-Host 'FINAL CLEANUP REPORT'
Write-Host '========================================='

Write-Host ''
Write-Host ('Temporary files found:   ' + $report.TempFilesFound)
Write-Host ('Temporary files deleted: ' + $report.TempFilesDeleted)
Write-Host ('Temporary files skipped: ' + $report.TempFilesSkipped)

Write-Host ''
Write-Host ('Estimated eligible space: ' + (Format-FileSize $report.TempBytesFound))
Write-Host ('Estimated space removed:  ' + (Format-FileSize $report.TempBytesDeleted))

Write-Host ''
Write-Host ('Recycle Bin: ' + $report.RecycleBinStatus)
Write-Host ('DNS Cache:   ' + $report.DNSStatus)

Write-Host ''
Write-Host 'Cleanup session finished.'
Write-Host 'Note: Actual free disk space may differ.'
Write-Host ''

Read-Host 'Press Enter to close'
`;

    function generateScript() {
      const tasks = [];

      if (temp.checked) {
        tasks.push(tempScript);
      }

      if (recycle.checked) {
        tasks.push(recycleScript);
      }

      if (dns.checked) {
        tasks.push(dnsScript);
      }

      if (tasks.length === 0) {
        results.classList.add("hidden");
        generatedScript = "";
        alert("Please select at least one cleanup task.");
        return;
      }

      generatedScript = [
        header,
        ...tasks,
        reportScript
      ].join("\n");

      preview.textContent = generatedScript;
      results.classList.remove("hidden");
      status.textContent = "";

      results.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });
    }

    function downloadScript() {
      if (!generatedScript) {
        return;
      }

      const blob = new Blob([generatedScript], {
        type: "text/plain;charset=utf-8"
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = "ShauneDrake-WindowsCleanup-v1.1.ps1";

      document.body.appendChild(link);
      link.click();
      link.remove();

      setTimeout(() => {
        URL.revokeObjectURL(url);
      }, 1000);

      status.textContent = "PowerShell script download requested.";
    }

    async function copyScript() {
      if (!generatedScript) {
        return;
      }

      try {
        await navigator.clipboard.writeText(generatedScript);

        status.textContent = "PowerShell script copied to clipboard.";
      }
      catch {
        status.textContent =
          "Unable to copy automatically. Select the preview text instead.";
      }
    }

    generateButton.addEventListener("click", generateScript);
    downloadButton.addEventListener("click", downloadScript);
    copyButton.addEventListener("click", copyScript);

    [temp, recycle, dns].forEach((checkbox) => {
      checkbox.addEventListener("change", () => {
        generatedScript = "";
        results.classList.add("hidden");
        status.textContent = "";
      });
    });
  </script>
</body>
</html>
